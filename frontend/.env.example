# Copy to .env.local (git ignores it) and fill in. Never commit a real address: this repository is public.

# Development only. The address the dev server forwards /v1 to. Ask the coordinator for the current one.
VITE_DEV_API=http://localhost:8000

# Development only. The address the dev server forwards /v1/ai-report and /v1/feedback to (the city service).
VITE_DEV_CITY=http://localhost:8100

# Development only. Extra host names the dev server answers to, comma separated (for example your machine's
# name on the team network). Names ending in .ts.net are always allowed.
DEV_ALLOWED_HOSTS=

# Build argument. Origin of the API. Empty means the same origin as the page. Public, so never a secret.
VITE_API_URL=

# Build argument. Origin of the city service. Empty means the same origin as the page. Public, so never a secret.
VITE_CITY_API_URL=
